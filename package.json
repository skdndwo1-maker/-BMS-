{
  "name": "axis",
  "version": "1.0.0",
  "description": "Axis — U+ 브랜드 디자인·네이밍·라이브러리·심플리 가이드·검수·관리 통합 플랫폼",
  "scripts": {
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n api,web -c blue,magenta \"npm run server:watch\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "start": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "analyze:guideline": "tsx scripts/analyze-lgu-guideline.ts",
    "migrate:guidelines": "tsx scripts/migrate-guidelines-json-to-supabase.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.104.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "serverless-http": "^4.0.0",
    "tsx": "^4.21.0",
    "undici": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2"
  }
}
