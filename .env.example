# Backend guideline + Gemini API
# 로컬: npm run server (기본 PORT=3001) · Vercel: Project Settings → Environment Variables에 동일 키 등록 (PORT 불필요)
PORT=3001
GEMINI_API_KEY=

# (선택) 프론트에서 API를 직접 호출할 때만. 비우면 브라우저는 같은 출처의 /api로 요청하고
# Vite가 localhost:3001로 프록시합니다. 값을 넣을 때는 호스트+포트만 (끝에 /api 붙이지 말 것).
# 로컬 개발 시 루트 `.env.development`에 기본값이 있으면 그대로 사용됩니다.
# VITE_API_URL=http://127.0.0.1:3001
# 텍스트/멀티모달 — 미설정 시 서버 기본: gemini-3.1-pro-preview (고성능). 404·쿼터 시 2.5-pro → 2.5-flash 순 폴백.
# GEMINI_MODEL=gemini-3.1-pro-preview
# 이미지 생성·수정 — 미설정 시 gemini-3.1-flash-image-preview → 2.5-flash-image 순 시도
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# (선택) 국가법령정보센터 Open API — https://open.law.go.kr/ 에서 OC 발급 후 설정
# DRF lawSearch (JSON): 서버는 /api/law/search?q=검색어 로 동일 API를 프록시하며, 브랜드 네이밍 시 적법성 맥락 보강에 사용합니다.
# 호출 허용을 위해 open.law.go.kr에 이 서버의 공인 IP(또는 도메인)를 등록해야 할 수 있습니다.
# 키는 프로젝트 루트 .env 뿐 아니라 server/.env 에 두어도 로드됩니다(루트 값이 우선).
# 백엔드 재시작 후 연동 확인: GET /api/law/status?probe=1
# LAW_API_OC=
# 호환: 기존 이름만 쓰는 경우
# LAW_GO_OC=
