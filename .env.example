# Backend guideline + Gemini API (root: npm run server)
PORT=3001
GEMINI_API_KEY=

# (선택) 프론트에서 API를 직접 호출할 때만. 비우면 브라우저는 같은 출처의 /api로 요청하고
# Vite가 localhost:3001로 프록시합니다. 값을 넣을 때는 호스트+포트만 (끝에 /api 붙이지 말 것).
# 로컬 개발 시 루트 `.env.development`에 기본값이 있으면 그대로 사용됩니다.
# VITE_API_URL=http://127.0.0.1:3001
# 텍스트/멀티모달 (gemini-2.0-flash는 신규 키에서 막히는 경우 많음 → 2.5-flash 권장)
# GEMINI_MODEL=gemini-2.5-flash
# Image revision output (defaults tried in server if unset)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (선택) 브랜드 네이밍 검수 — KIPRIS Plus 상표 검색 API
# https://plus.kipris.or.kr/portal/main.do — API 통합설명서의 정확한 REST 경로 사용
# KIPRIS_SERVICE_KEY=   # 공공데이터포털 발급 키. % 인코딩된 값으로 저장해도 서버에서 디코딩해 사용
# 아래 중 하나에 동일 키를 넣어도 됩니다 (서버에서 동일하게 인식)
# KIPLUS_API_KEY=
# KIPLUS_SERVICE_KEY=
# 기본 동작: trademarkInfoSearchService/getWordSearch 등 후보 URL을 순차 시도
# 명세와 다르면 전체 URL을 지정 (선택적으로 {key} {query} 치환)
# KIPRIS_TRADEMARK_SEARCH_URL=
# KIPRIS_TRADEMARK_OPERATION=trademarkInfoSearchService/getWordSearch
# KIPRIS_WORD_PARAM=searchString
# KIPRIS_KEY_PARAM=ServiceKey

# (선택) 국가법령정보센터 Open API — https://open.law.go.kr/ OC(기관코드) 발급 후 설정
# LAW_GO_OC=
