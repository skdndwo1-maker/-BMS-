# Backend guideline + Gemini API (root: npm run server)
PORT=3001
GEMINI_API_KEY=

# (선택) 프론트에서 API를 직접 호출할 때만. 비우면 브라우저는 같은 출처의 /api로 요청하고
# Vite가 localhost:3001로 프록시합니다. 값을 넣을 때는 호스트+포트만 (끝에 /api 붙이지 말 것).
# 로컬 개발 시 루트 `.env.development`에 기본값이 있으면 그대로 사용됩니다.
# VITE_API_URL=http://127.0.0.1:3001
# 텍스트/멀티모달 (gemini-2.0-flash는 신규 키에서 막히는 경우 많음 → 2.5-flash 권장)
# GEMINI_MODEL=gemini-2.5-flash
# Image revision output (defaults tried in server if unset)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (선택) 국가법령정보센터 Open API — https://open.law.go.kr/ OC(기관코드) 발급 후 설정
# LAW_API_OC=
# 호환: 기존 이름만 쓰는 경우
# LAW_GO_OC=
